---
import Layout from "../layouts/Layout.astro";
import historyRaw from "../data/history.json";
import manifestRaw from "../data/regions.json";

interface RegionMeta { slug: string; label: string; cities: string }
interface PlanPoint { c: number; n: string }
interface MonthSummary {
  avg: number; median: number; cheapest: number; honest: number;
  plans?: Record<string, PlanPoint>;
}

const history = historyRaw as unknown as {
  updated: string;
  months: Record<string, Record<string, MonthSummary>>;
};
const manifest = manifestRaw as unknown as { regions: RegionMeta[] };

const base = import.meta.env.BASE_URL;
const months = Object.keys(history.months).sort();
const latest = months[months.length - 1];
const prev = months.length >= 2 ? months[months.length - 2] : null;
const latestData = history.months[latest];

// "Plans that changed" — diff the two most recent months for a representative
// region (Oncor, the largest). Plans are keyed by a name signature, so they
// match across months even though the feed's internal ids change.
const PRICE_EPS = 0.15; // ¢/kWh: ignore sub-rounding noise
const CHANGE_REGION = manifest.regions.find((r) => r.slug === "oncor") ?? manifest.regions[0];
type Move = { name: string; from: number; to: number };
let newPlans: string[] = [];
let gonePlans: string[] = [];
let roseP: Move[] = [];
let dropP: Move[] = [];
if (prev) {
  const before = history.months[prev]?.[CHANGE_REGION.slug]?.plans ?? {};
  const after = latestData?.[CHANGE_REGION.slug]?.plans ?? {};
  for (const [k, v] of Object.entries(after)) {
    if (!(k in before)) newPlans.push(v.n);
    else {
      const d = v.c - before[k].c;
      if (d > PRICE_EPS) roseP.push({ name: v.n, from: before[k].c, to: v.c });
      else if (d < -PRICE_EPS) dropP.push({ name: v.n, from: before[k].c, to: v.c });
    }
  }
  for (const [k, v] of Object.entries(before)) if (!(k in after)) gonePlans.push(v.n);
  roseP.sort((a, b) => b.to - b.from - (a.to - a.from));   // biggest hikes first
  dropP.sort((a, b) => a.to - a.from - (b.to - b.from));   // biggest drops first
}
const updated = new Date(history.updated).toLocaleDateString("en-US", {
  year: "numeric", month: "short", day: "numeric",
});
const monthLabel = (m: string) => {
  // Build the date from local components to avoid the UTC-parse timezone shift
  // that would render "2026-07" as "Jun 2026" in negative-offset timezones.
  const [y, mo] = m.split("-").map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

// Regional comparison (current month): cheapest honest ¢/kWh, ranked.
const compare = manifest.regions
  .map((r) => ({ ...r, ...(latestData[r.slug] ?? { cheapest: 0, avg: 0, honest: 0 }) }))
  .filter((r) => r.honest > 0)
  .sort((a, b) => a.cheapest - b.cheapest);
const maxCheap = Math.max(...compare.map((r) => r.cheapest), 1);

// Time series (avg ¢/kWh per region). One point per recorded month.
const W = 620, H = 240, PADX = 44, PADY = 28;
const allAvg = months.flatMap((m) => Object.values(history.months[m]).map((s) => s.avg));
const yMin = Math.floor(Math.min(...allAvg) - 1);
const yMax = Math.ceil(Math.max(...allAvg) + 1);
const xOf = (i: number) => (months.length === 1 ? W / 2 : PADX + (i / (months.length - 1)) * (W - 2 * PADX));
const yOf = (v: number) => H - PADY - ((v - yMin) / (yMax - yMin)) * (H - 2 * PADY);
const palette = ["#0b5d3b", "#9a2a2a", "#2a5a6a", "#9a6a12", "#5a3b8a", "#3b6a2a"];
const series = manifest.regions.map((r, idx) => ({
  label: r.label,
  color: palette[idx % palette.length],
  points: months
    .map((m, i) => (history.months[m][r.slug] ? { x: xOf(i), y: yOf(history.months[m][r.slug].avg) } : null))
    .filter(Boolean) as { x: number; y: number }[],
}));
---

<Layout title="Texas electricity price trends by region | Honest Texas Electricity"
        description="Average honest electricity prices by Texas region, tracked over time to help you time your switch."
        updated={updated}>
  <p class="crumb"><a href={base}>← Honest Texas Electricity</a> · Price trends</p>
  <h1 class="autopsy-h1">Texas price trends</h1>
  <p class="autopsy-verdict-lead">
    Average and cheapest honest prices by region, so you can see where prices sit and
    time your switch. We record a snapshot every month.
  </p>

  <section class="curve">
    <h2>Cheapest honest plan by region — {monthLabel(latest)}</h2>
    <p class="curve-note">Lowest true cost at 1,000 kWh among plans that passed our honest filter.</p>
    <div class="bars">
      {compare.map((r) => (
        <div class="bar-row">
          <a class="bar-label" href={`${base}plans/${r.slug}`}>{r.label}</a>
          <div class="bar-track">
            <div class="bar-fill" style={`width:${(r.cheapest / maxCheap) * 100}%`}></div>
          </div>
          <span class="bar-val mono">{r.cheapest.toFixed(1)}¢</span>
        </div>
      ))}
    </div>
  </section>

  <section class="curve">
    <h2>Average price over time</h2>
    {months.length < 2 ? (
      <p class="curve-note">
        <strong>Month 1 of tracking ({monthLabel(latest)}).</strong> The trend lines fill
        in as we record a snapshot each month — check back to spot when prices dip and
        it's a good time to switch. We don't invent past data.
      </p>
    ) : (
      <p class="curve-note">Average honest ¢/kWh at 1,000 kWh, per region, over {months.length} months.</p>
    )}
    <svg viewBox={`0 0 ${W} ${H}`} class="trend-svg" role="img" aria-label="Average price per region over time">
      {[yMin, Math.round((yMin + yMax) / 2), yMax].map((v) => (
        <g>
          <line x1={PADX} y1={yOf(v)} x2={W - PADX} y2={yOf(v)} class="axis" />
          <text x={PADX - 6} y={yOf(v) + 3} text-anchor="end" class="curve-x">{v}¢</text>
        </g>
      ))}
      {months.map((m, i) => (
        <text x={xOf(i)} y={H - 8} text-anchor="middle" class="curve-x">{monthLabel(m)}</text>
      ))}
      {series.map((s) => (
        <g>
          {s.points.length > 1 && (
            <polyline points={s.points.map((p) => `${p.x},${p.y}`).join(" ")} fill="none" stroke={s.color} stroke-width="2" />
          )}
          {s.points.map((p) => <circle cx={p.x} cy={p.y} r="3.5" fill={s.color} />)}
        </g>
      ))}
    </svg>
    <div class="legend">
      {series.map((s) => (<span class="legend-item"><span class="swatch" style={`background:${s.color}`}></span>{s.label}</span>))}
    </div>
  </section>

  <section class="changed">
    <div class="changed-head">
      <h2>What changed in <span id="ch-region">{CHANGE_REGION.label}</span></h2>
      {prev && (
        <label class="ch-picker">Area:
          <select id="ch-select">
            {manifest.regions.map((r) => (
              <option value={r.slug} selected={r.slug === CHANGE_REGION.slug}>{r.label}</option>
            ))}
          </select>
        </label>
      )}
    </div>
    {!prev ? (
      <p class="curve-note">
        <strong>Month 1 of tracking ({monthLabel(latest)}).</strong> Once we've recorded a
        second month, this is where we'll flag plans whose price rose, new plans, and plans
        that disappeared. We don't invent past data — check back next month.
      </p>
    ) : (
      <div id="ch-body">
        <p class="curve-note" id="ch-summary">
          {monthLabel(prev)} → {monthLabel(latest)} for honest plans in {CHANGE_REGION.label}.
          {" "}<strong>{roseP.length}</strong> went up, <strong>{dropP.length}</strong> came down,
          {" "}<strong>{newPlans.length}</strong> new, <strong>{gonePlans.length}</strong> gone.
        </p>

        {roseP.length > 0 && (
          <div class="change-block" data-block="rose">
            <h3 class="change-h up">Prices that went up</h3>
            {roseP.slice(0, 6).map((m) => (
              <div class="change-row">
                <span class="change-name">{m.name}</span>
                <span class="change-move mono">{m.from.toFixed(1)}¢ <span class="up">→ {m.to.toFixed(1)}¢</span></span>
              </div>
            ))}
          </div>
        )}

        {dropP.length > 0 && (
          <div class="change-block" data-block="drop">
            <h3 class="change-h down">Prices that came down</h3>
            {dropP.slice(0, 6).map((m) => (
              <div class="change-row">
                <span class="change-name">{m.name}</span>
                <span class="change-move mono">{m.from.toFixed(1)}¢ <span class="down">→ {m.to.toFixed(1)}¢</span></span>
              </div>
            ))}
          </div>
        )}

        <div class="change-two">
          {newPlans.length > 0 && (
            <div class="change-block" data-block="new">
              <h3 class="change-h">New this month ({newPlans.length})</h3>
              {newPlans.slice(0, 6).map((n) => <div class="change-row"><span class="change-name">{n}</span></div>)}
              {newPlans.length > 6 && <p class="curve-note">…and {newPlans.length - 6} more</p>}
            </div>
          )}
          {gonePlans.length > 0 && (
            <div class="change-block" data-block="gone">
              <h3 class="change-h">No longer offered ({gonePlans.length})</h3>
              {gonePlans.slice(0, 6).map((n) => <div class="change-row"><span class="change-name gone">{n}</span></div>)}
              {gonePlans.length > 6 && <p class="curve-note">…and {gonePlans.length - 6} more</p>}
            </div>
          )}
        </div>
      </div>
    )}
  </section>

  {prev && (
    <script type="application/json" id="ch-data" set:html={JSON.stringify({
      prev, latest,
      prevLabel: monthLabel(prev), latestLabel: monthLabel(latest),
      regions: manifest.regions.map((r) => ({ slug: r.slug, label: r.label })),
      months: history.months,
    })} />
  )}

  <script>
    // Region-switchable "what changed" diff. Guarded so it no-ops on the
    // single-month page (no data script / selector). Kept at template top level
    // so Astro bundles it (module scripts inside JSX conditionals are skipped).
    (() => {
      interface PlanPoint { c: number; n: string }
      const dataEl = document.getElementById("ch-data");
      const sel = document.getElementById("ch-select") as HTMLSelectElement | null;
      const body = document.getElementById("ch-body");
      const regionName = document.getElementById("ch-region");
      if (!dataEl || !sel || !body || !regionName) return;

      const cfg = JSON.parse(dataEl.textContent!) as {
        prev: string; latest: string; prevLabel: string; latestLabel: string;
        regions: { slug: string; label: string }[];
        months: Record<string, Record<string, { plans?: Record<string, PlanPoint> }>>;
      };
      const EPS = 0.15;
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));

      function rows(items: string[], gone = false) {
          const head = items.slice(0, 6)
            .map((n) => `<div class="change-row"><span class="change-name${gone ? " gone" : ""}">${esc(n)}</span></div>`)
            .join("");
          const more = items.length > 6 ? `<p class="curve-note">…and ${items.length - 6} more</p>` : "";
          return head + more;
        }
        function moveRows(items: { name: string; from: number; to: number }[], cls: "up" | "down") {
          return items.slice(0, 6).map((m) =>
            `<div class="change-row"><span class="change-name">${esc(m.name)}</span>` +
            `<span class="change-move mono">${m.from.toFixed(1)}¢ <span class="${cls}">→ ${m.to.toFixed(1)}¢</span></span></div>`,
          ).join("");
        }

        function render(slug: string) {
          const label = cfg.regions.find((r) => r.slug === slug)?.label ?? slug;
          regionName.textContent = label;
          const before = cfg.months[cfg.prev]?.[slug]?.plans ?? {};
          const after = cfg.months[cfg.latest]?.[slug]?.plans ?? {};
          const newP: string[] = [], goneP: string[] = [];
          const rose: { name: string; from: number; to: number }[] = [];
          const drop: { name: string; from: number; to: number }[] = [];
          for (const [k, v] of Object.entries(after)) {
            if (!(k in before)) newP.push(v.n);
            else {
              const d = v.c - before[k].c;
              if (d > EPS) rose.push({ name: v.n, from: before[k].c, to: v.c });
              else if (d < -EPS) drop.push({ name: v.n, from: before[k].c, to: v.c });
            }
          }
          for (const [k, v] of Object.entries(before)) if (!(k in after)) goneP.push(v.n);
          rose.sort((a, b) => b.to - b.from - (a.to - a.from));
          drop.sort((a, b) => a.to - a.from - (b.to - b.from));

          let html = `<p class="curve-note">${cfg.prevLabel} → ${cfg.latestLabel} for honest plans in ${esc(label)}. ` +
            `<strong>${rose.length}</strong> went up, <strong>${drop.length}</strong> came down, ` +
            `<strong>${newP.length}</strong> new, <strong>${goneP.length}</strong> gone.</p>`;
          if (rose.length) html += `<div class="change-block"><h3 class="change-h up">Prices that went up</h3>${moveRows(rose, "up")}</div>`;
          if (drop.length) html += `<div class="change-block"><h3 class="change-h down">Prices that came down</h3>${moveRows(drop, "down")}</div>`;
          html += `<div class="change-two">`;
          if (newP.length) html += `<div class="change-block"><h3 class="change-h">New this month (${newP.length})</h3>${rows(newP)}</div>`;
          if (goneP.length) html += `<div class="change-block"><h3 class="change-h">No longer offered (${goneP.length})</h3>${rows(goneP, true)}</div>`;
          html += `</div>`;
          if (!rose.length && !drop.length && !newP.length && !goneP.length)
            html += `<p class="curve-note">No changes recorded in ${esc(label)} this month.</p>`;
          body.innerHTML = html;
        }

        sel.addEventListener("change", () => render(sel.value));
    })();
  </script>
</Layout>
